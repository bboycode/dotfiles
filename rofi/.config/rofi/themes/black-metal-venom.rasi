/*
 * Black Metal Venom colorscheme for Rofi
 * User: Britton Petersen
 */

* {
    bg: #000000;            /* main background */
    hv: #c72a28;            /* highlight / hover */
    primary: #c1c1c1;       /* default text */
    ug: #211816;             /* dark accent / borders */
    font: "Monospace 11";

    background-color: @bg;
    border: 0px;
    kl: #5f8787;             /* selection / keys */
    black: #000000;
    transparent: rgba(0,0,0,0);
}

/* Window container */
window {
	fullscreen: true;
    orientation: horizontal;
    location: center;
    anchor: center;
    transparency: "screenshot";
    border-color: @transparent;
    border: 0px;
    border-radius: 6px;
    spacing: 0;
    children: [ mainbox ];
}

/* Main layout container */
mainbox {
    spacing: 0;
    children: [ inputbar, listview ];
}

/* Input bar at top */
inputbar {
    color: @kl;
    padding: 11px;
    border: 3px 3px 2px 3px;
    border-color: @primary;
    border-radius: 6px 6px 0px 0px;
}

/* Message area */
message {
    padding: 0;
    border-color: @primary;
    border: 0px 1px 1px 1px;
}

/* Entries and prompt */
entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

entry {
    cursor: pointer;
}

prompt {
    margin: 0px 5px 0px 0px;
}

/* List view (options) */
listview {
    layout: vertical;
    padding: 8px;
    lines: 12;
    columns: 1;
    border: 0px 3px 3px 3px;
    border-radius: 0px 0px 6px 6px;
    border-color: @primary;
    dynamic: false;
}

/* Elements */
element {
    padding: 2px;
    vertical-align: 1;
    color: @kl;
    font: inherit;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

/* Selected item normal state */
element selected.normal {
    color: @black;
    background-color: @hv;
}

/* Active elements */
element normal active {
    background-color: @hv;
    color: @black;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

/* Urgent elements (e.g., warnings) */
element normal urgent {
    background-color: @c72a28;
}

/* Selected active */
element selected active {
    background: @hv;
    foreground: @bg;
}

/* Buttons */
button {
    padding: 6px;
    color: @primary;
    horizontal-align: 0.5;
    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    border-color: @primary;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @primary;
}

/* Scrollbar */
scrollbar {
    enabled: true;
}

